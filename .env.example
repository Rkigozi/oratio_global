# Supabase Configuration
# Create a project at https://supabase.com and copy these values from Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Google Cloud Translation — set server-side only
# The translation Edge Function reads this from Supabase secrets:
#   supabase secrets set GOOGLE_TRANSLATE_API_KEY=your-key
# Do NOT set VITE_GOOGLE_TRANSLATE_API_KEY — it would expose the key in the client bundle.

# Sentry (error monitoring)
# Create a project at https://sentry.io and copy the DSN
VITE_SENTRY_DSN=https://example@sentry.io/your-project

# PostHog (analytics)
# Create a project at https://us.posthog.com and copy the API key
VITE_POSTHOG_KEY=phc_your_posthog_key
