{
  "name": "oratio",
  "private": true,
  "version": "0.0.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || ^26.0.0 || >=27.0.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @oratio/web",
    "build": "npm run build --workspace @oratio/web",
    "preview": "npm run preview --workspace @oratio/web",
    "lint": "npm run lint --workspace @oratio/web",
    "format": "prettier --write .",
    "type-check": "npm run type-check --workspace @oratio/web",
    "test": "npm run test --workspace @oratio/web",
    "test:watch": "npm run test:watch --workspace @oratio/web",
    "test:coverage": "npm run test:coverage --workspace @oratio/web",
    "test:e2e": "npm run test:e2e --workspace @oratio/web",
    "test:e2e:remote": "npm run test:e2e:remote --workspace @oratio/web",
    "qa:account-deletion": "npm run qa:account-deletion --workspace @oratio/web",
    "qa:translation": "npm run qa:translation --workspace @oratio/web",
    "dev:mobile": "npm run start --workspace @oratio/mobile",
    "ios": "npm run ios --workspace @oratio/mobile",
    "type-check:mobile": "npm run typecheck --workspace @oratio/mobile",
    "prepare": "husky",
    "postinstall": "node scripts/security-backports/forge-backport.mjs",
    "install:security-backport": "node scripts/security-backports/forge-backport.mjs",
    "verify:security-backport": "node scripts/security-backports/forge-backport.mjs --verify-only",
    "format:check": "prettier --check .",
    "test:mobile": "npm run test --workspace @oratio/mobile",
    "audit:web": "npm audit -w @oratio/web --omit=dev --audit-level=high",
    "audit:web:tooling": "npm audit -w @oratio/web --include=dev --audit-level=high",
    "audit:mobile": "node scripts/security-backports/audit-mobile.mjs",
    "audit:mobile:raw": "npm audit -w @oratio/mobile --omit=dev --audit-level=high",
    "audit:mobile:release": "node scripts/security-backports/audit-mobile.mjs --release",
    "test:db": "node scripts/test-moderation-db.mjs",
    "test:security-backports": "node --test scripts/security-backports/*.test.mjs"
  },
  "devDependencies": {
    "vite": "6.4.5",
    "@types/react": "19.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "react-test-renderer": "19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "expo": "~58.0.21"
  },
  "lint-staged": {
    "apps/web/**/*.{ts,tsx}": [
      "prettier --write",
      "node scripts/lint-web.mjs"
    ],
    "apps/mobile/**/*.{ts,tsx}": [
      "prettier --write"
    ],
    "packages/shared/**/*.ts": [
      "prettier --write"
    ]
  },
  "overrides": {
    "vite": "6.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "@testing-library/react-native": {
      "react-test-renderer": "19.3.0"
    }
  }
}
