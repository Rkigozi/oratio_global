EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# A publishable key is preferred; legacy anon keys also work. Never use a server key.
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Configure these same names in EAS preview/production before building.
# Local .env files are not uploaded. EXPO_PUBLIC values are included in the app.
# Optional: use an isolated Netlify deploy preview for notice QA, then remove it.
# Leave unset in production to use the normal Oratio website.
# EXPO_PUBLIC_SERVICE_NOTICE_URL=https://your-preview.netlify.app/.netlify/functions/service-notice
# Error reporting is OFF unless explicitly enabled with complete metadata.
# See docs/backlog/NATIVE-MONITORING.md. Never put SENTRY_AUTH_TOKEN in EXPO_PUBLIC_*.
# EXPO_PUBLIC_SENTRY_ENABLED=true
# EXPO_PUBLIC_SENTRY_DSN=<public DSN for the approved Oratio mobile Sentry project>
# EXPO_PUBLIC_SENTRY_ENVIRONMENT=development
# EXPO_PUBLIC_GIT_SHA=<40-character committed Git SHA; EAS uses EAS_BUILD_GIT_COMMIT_HASH>
